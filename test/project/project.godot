; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the properties have different types.

[configuration]

config_version=5

[application]

config/name="Interaction System Test"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://test_main.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/interaction_system/plugin.cfg")

[xr]

openxr/enabled=true
